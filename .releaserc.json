{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "repositoryUrl": "https://gitlab.com/lecoteaufleuri/app.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "./tool/semantic-release/release-outputs.cjs"
  ]
}
